<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>WinExe</OutputType>
	<TargetFramework>net9.0-windows</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<UseWPF>true</UseWPF>
	<!-- WinForms is enabled solely for the tray NotifyIcon (no extra NuGet needed). -->
	<UseWindowsForms>true</UseWindowsForms>
	<ApplicationManifest>app.manifest</ApplicationManifest>
	<ApplicationIcon>Assets\Icon.ico</ApplicationIcon>
    <UserSecretsId>d2185b7b-b2db-438e-9a76-f08d51c63093</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
	<ProjectReference Include="..\Hark.Core\Hark.Core.csproj" />
	<ProjectReference Include="..\Hark.Oracle\Hark.Oracle.csproj" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
	<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
	<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
	<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.11" />
	<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

</Project>
