<Window x:Class="Hark.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hark.App"
        Title="HARK Captions"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        SizeToContent="Manual"
        Width="900" Height="150"
        MinWidth="420" MinHeight="96"
        WindowStartupLocation="Manual">

    <!-- Root layer: the docked bar plus the full-window Vision ("crystal ball") page that overlays it. -->
    <Grid x:Name="RootLayer">

        <!-- Live-Captions-style bar: dark translucent, rounded, soft shadow. Done right: the transcript
         is selectable/copyable and the window is resizable + scrollable, unlike native Live Captions. -->
        <Border x:Name="Bar"
            VerticalAlignment="Top"
            CornerRadius="0,0,12,12"
            Margin="0,0,0,12"
            Padding="20,10">
            <Border.Background>
                <SolidColorBrush Color="#000000" Opacity="0.82" />
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="#000000" />
            </Border.Effect>

            <Border.Resources>
                <!-- Pill button used for the per-speaker shortcuts in the CAPTIONS index. -->
                <Style x:Key="SpeakerButtonStyle" TargetType="Button">
                    <Setter Property="Foreground" Value="#E6E8EA" />
                    <Setter Property="Background" Value="#2A2D31" />
                    <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Margin" Value="0,0,6,0" />
                    <Setter Property="Padding" Value="10,3" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="{TemplateBinding Background}"
                                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#3B7DDD" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Segmented mode-switch button (CAPTIONS / SUMMARY). Selected look is set in code-behind. -->
                <Style x:Key="ModeButtonStyle" TargetType="Button">
                    <Setter Property="Foreground" Value="#9AA0A6" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="12,4" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <!-- Collapsible section header (MEETING NOTES / FOLLOW-UP TASKS / SPEAKERS):
                                 a chevron + label that shows/hides its list; the window auto-sizes to the
                                 revealed content. -->
                <Style x:Key="SectionToggleStyle" TargetType="ToggleButton">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#5F6368" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="Margin" Value="2,10,0,6" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="{TemplateBinding Background}"
                                                    Padding="2,3" CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <Path x:Name="Chevron" Width="7" Height="9"
                                                          Margin="0,1,8,0" VerticalAlignment="Center"
                                                          Stretch="Fill" Fill="{TemplateBinding Foreground}"
                                                          Data="M 0 0 L 5 5 L 0 10 Z"
                                                          RenderTransformOrigin="0.5,0.5" />
                                        <TextBlock Text="{TemplateBinding Content}"
                                                               FontFamily="Segoe UI Variable, Segoe UI"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{TemplateBinding Foreground}" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Chevron" Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="90" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#9AA0A6" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Converters used by the structured recap templates. -->
                <BooleanToVisibilityConverter x:Key="BoolToVis" />
                <local:NullOrEmptyToVisibilityConverter x:Key="OwnerVis" />

                <!-- Borderless toggle header for an expandable topic card. -->
                <Style x:Key="TopicToggleStyle" TargetType="ToggleButton">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="bg" Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="12,10">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#232629" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Meeting-notes topic: collapsible header (title + one-line summary) that
                                 expands to reveal detail bullets, mirroring the Teams Recap experience. -->
                <DataTemplate x:Key="TopicTemplate">
                    <Border Background="#16181A" CornerRadius="8" Margin="0,0,0,6">
                        <StackPanel>
                            <ToggleButton x:Name="Toggle" Style="{StaticResource TopicToggleStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="Chevron" Grid.Column="0"
                                                      Width="8" Height="10" Margin="0,5,12,0"
                                                      VerticalAlignment="Top" Stretch="Fill"
                                                      Fill="#9AA0A6" Data="M 0 0 L 5 5 L 0 10 Z"
                                                      RenderTransformOrigin="0.5,0.5" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}"
                                                               FontFamily="Segoe UI Variable, Segoe UI"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               Foreground="#FFFFFF" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Summary}"
                                                               FontFamily="Segoe UI Variable, Segoe UI"
                                                               FontSize="12" Foreground="#9AA0A6"
                                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </ToggleButton>

                            <ItemsControl ItemsSource="{Binding Details}" Margin="32,0,12,10"
                                                      Visibility="{Binding IsChecked, ElementName=Toggle,
                                                                   Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#8226;" Foreground="#5F6368"
                                                                   Margin="0,0,8,0" VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1" Text="{Binding}"
                                                                   FontFamily="Segoe UI Variable, Segoe UI"
                                                                   FontSize="13" Foreground="#D0D3D6"
                                                                   TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=Toggle}" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>

                <!-- Single-level follow-up task: a checkbox glyph, the task text, and an
                                 optional owner pill. -->
                <DataTemplate x:Key="TaskTemplate">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#9744;" Foreground="#5F6368" FontSize="15"
                                               Margin="0,0,8,0" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding Task}"
                                               FontFamily="Segoe UI Variable, Segoe UI"
                                               FontSize="13" Foreground="#E6E8EA" TextWrapping="Wrap" />
                        <Border Grid.Column="2" Background="#2A2D31" CornerRadius="8"
                                            Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Top"
                                            Visibility="{Binding Owner, Converter={StaticResource OwnerVis}}">
                            <TextBlock Text="{Binding Owner}" Foreground="#9AA0A6"
                                                   FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" />
                        </Border>
                    </Grid>
                </DataTemplate>

                <!-- Speaker card: same expand-to-reveal idiom as a topic, but pivoted on a
                                 person — a blue speaker dot, the Guest label, and a one-line characterization
                                 that expands to their points. Complements the topic-pivoted Conversation view. -->
                <DataTemplate x:Key="SpeakerTemplate">
                    <Border Background="#16181A" CornerRadius="8" Margin="0,0,0,6">
                        <StackPanel>
                            <ToggleButton x:Name="Toggle" Style="{StaticResource TopicToggleStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="Chevron" Grid.Column="0"
                                                      Width="8" Height="10" Margin="0,5,12,0"
                                                      VerticalAlignment="Top" Stretch="Fill"
                                                      Fill="#9AA0A6" Data="M 0 0 L 5 5 L 0 10 Z"
                                                      RenderTransformOrigin="0.5,0.5" />
                                    <Ellipse Grid.Column="1" Width="8" Height="8"
                                                         Margin="0,7,8,0" VerticalAlignment="Top" Fill="#3B7DDD" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Speaker}"
                                                               FontFamily="Segoe UI Variable, Segoe UI"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               Foreground="#FFFFFF" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Summary}"
                                                               FontFamily="Segoe UI Variable, Segoe UI"
                                                               FontSize="12" Foreground="#9AA0A6"
                                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </ToggleButton>

                            <ItemsControl ItemsSource="{Binding Points}" Margin="32,0,12,10"
                                                      Visibility="{Binding IsChecked, ElementName=Toggle,
                                                                   Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#8226;" Foreground="#5F6368"
                                                                   Margin="0,0,8,0" VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1" Text="{Binding}"
                                                                   FontFamily="Segoe UI Variable, Segoe UI"
                                                                   FontSize="13" Foreground="#D0D3D6"
                                                                   TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=Toggle}" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Border.Resources>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Slim header acts as the drag handle and shows live status; hosts the close button. -->
                <Grid Grid.Row="0" x:Name="DragHandle" Background="Transparent" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- HAL-9000-style eye: silver frame, black socket, glowing red cornea (recording),
                     with a glass gloss highlight. Idle = dim; running/reactive = lit + glow.
                     Click to dilate into the full-window Vision page. -->
                    <Grid Grid.Column="0" x:Name="HalEye" Width="18" Height="18" VerticalAlignment="Center"
                      Background="Transparent" Cursor="Hand" ToolTip="Open Vision">
                        <Ellipse>
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EDF1F4" Offset="0" />
                                    <GradientStop Color="#9AA1A8" Offset="0.5" />
                                    <GradientStop Color="#4E5459" Offset="1" />
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Margin="2" Fill="#0A0A0B" />
                        <Ellipse x:Name="HalCornea" Margin="4,4,4,0" RenderTransformOrigin="0.5,0.5" Height="10" VerticalAlignment="Top">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#FFD2C2" Offset="0" />
                                    <GradientStop Color="#FF1E10" Offset="0.42" />
                                    <GradientStop Color="#4A0000" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="HalGlow" Color="#FF1A14"
                                              ShadowDepth="0" BlurRadius="8" Opacity="0" />
                            </Ellipse.Effect>
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="HalScale" ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <!-- Glass dome reflection: a small top-only highlight so it reads as glass without
                         washing the cornea's saturated red. -->
                        <Ellipse Margin="5,3,8,10" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#59FFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="0.7" />
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <TextBlock Grid.Column="1" Margin="8,0,0,0"
                           Text="HARK"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#9AA0A6" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" x:Name="HintText"
                           Text="Ctrl+Win+H to toggle"
                           HorizontalAlignment="Right"
                           Margin="12,0,0,0"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="11"
                           Foreground="#5F6368" VerticalAlignment="Center" />

                    <!-- Copy button: copies whatever the window currently shows — the captions (per the
                     LATEST/TRANSCRIPT scope) or the recap (per the CONVERSATION/SPEAKERS style). -->
                    <Button Grid.Column="3" x:Name="CopyButton"
                        Width="22" Height="22" Margin="10,0,0,0" Padding="0"
                        FontFamily="Segoe MDL2 Assets" FontSize="12"
                        Content="&#xE8C8;"
                        Foreground="#9AA0A6" Background="Transparent"
                        BorderThickness="0" Cursor="Hand"
                        ToolTip="Copy what's shown to the clipboard">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#2A2D31" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Mic toggle: mixes the local microphone — your own voice — into the captioned
                     stream. Lit = on. State/glyph set in code-behind. -->
                    <Button Grid.Column="4" x:Name="MicButton"
                        Width="22" Height="22" Margin="10,0,0,0" Padding="0"
                        FontFamily="Segoe MDL2 Assets" FontSize="13"
                        Content="&#xE720;"
                        Foreground="#9AA0A6" Background="Transparent"
                        BorderThickness="0" Cursor="Hand"
                        ToolTip="Mix in your microphone (your voice)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#2A2D31" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Close button (✕): exits HARK. Red hover mirrors native window chrome. -->
                    <Button Grid.Column="5" x:Name="CloseButton"
                        Width="22" Height="22" Margin="10,0,0,0" Padding="0"
                        Content="✕" FontSize="11"
                        Foreground="#C8CCD0" Background="Transparent"
                        BorderThickness="0" Cursor="Hand"
                        ToolTip="Close HARK">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#E03A3A" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Mode switch (CAPTIONS / SUMMARY). Kept visually distinct from the speaker pills. -->
                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="9" Padding="2"
                        Background="#1C1E20" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="CaptionsModeButton" Content="CAPTIONS"
                                Style="{StaticResource ModeButtonStyle}" />
                            <Button x:Name="SummaryModeButton" Content="SUMMARY"
                                Style="{StaticResource ModeButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- Recap style switch (CONVERSATION / SPEAKERS); only shown in SUMMARY mode. -->
                    <Border Grid.Column="2" x:Name="StyleSwitch" CornerRadius="9" Padding="2"
                        Background="#1C1E20" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ConversationStyleButton" Content="CONVERSATION"
                                Style="{StaticResource ModeButtonStyle}" />
                            <Button x:Name="SpeakersStyleButton" Content="SPEAKERS"
                                Style="{StaticResource ModeButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- Caption scope switch (LATEST line / full TRANSCRIPT); only shown in CAPTIONS mode. -->
                    <Border Grid.Column="2" x:Name="ScopeSwitch" CornerRadius="9" Padding="2"
                        Background="#1C1E20" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="LatestScopeButton" Content="LATEST"
                                Style="{StaticResource ModeButtonStyle}" />
                            <Button x:Name="TranscriptScopeButton" Content="TRANSCRIPT"
                                Style="{StaticResource ModeButtonStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Speaker index: one pill per detected speaker; opens that speaker's page. -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6"
                        x:Name="SpeakerBarPanel" Visibility="Collapsed">
                    <TextBlock Text="Speakers:" VerticalAlignment="Center" Margin="0,0,8,0"
                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="11"
                           Foreground="#5F6368" />
                    <ItemsControl x:Name="SpeakerBar">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- Content area: captions and summary overlap here and cross-fade on mode switch. -->
                <Grid Grid.Row="3">
                    <!-- Rolling transcript: read-only but selectable + copyable, and scrollable when expanded. -->
                    <RichTextBox x:Name="CaptionBox"
                         IsReadOnly="True"
                         IsDocumentEnabled="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         MinHeight="44" MaxHeight="220"
                         Foreground="#FFFFFF"
                         FontFamily="Segoe UI Variable, Segoe UI"
                         FontSize="26"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                        <RichTextBox.Resources>
                            <Style TargetType="Paragraph">
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="LineHeight" Value="34" />
                            </Style>
                        </RichTextBox.Resources>
                        <RichTextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="CopyItem" Header="Copy" InputGestureText="Ctrl+C" />
                                <MenuItem x:Name="CopyAllItem" Header="Copy all" />
                            </ContextMenu>
                        </RichTextBox.ContextMenu>
                        <FlowDocument x:Name="CaptionDoc" PagePadding="0" />
                    </RichTextBox>

                    <!-- Summary view: hidden until SUMMARY mode; faded in over the captions. Hosts either
                     plain recap text (Narrative / PerSpeaker) or the structured, expandable Teams recap. -->
                    <ScrollViewer x:Name="SummaryScroll"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed" Opacity="0">
                        <Grid>
                            <TextBox x:Name="SummaryText"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#FFFFFF"
                                 FontFamily="Segoe UI Variable, Segoe UI"
                                 FontSize="16"
                                 Text="" />

                            <!-- Structured Teams-style recap: overview, collapsible meeting notes + tasks. -->
                            <StackPanel x:Name="RecapPanel" Visibility="Collapsed">
                                <TextBlock x:Name="RecapOverview"
                                       FontFamily="Segoe UI Variable, Segoe UI"
                                       FontSize="15" Foreground="#E6E8EA"
                                       TextWrapping="Wrap" Margin="2,0,0,2" />

                                <ToggleButton x:Name="NotesToggle" Content="MEETING NOTES"
                                          Style="{StaticResource SectionToggleStyle}" />
                                <ItemsControl x:Name="TopicList"
                                          ItemTemplate="{StaticResource TopicTemplate}"
                                          Visibility="{Binding IsChecked, ElementName=NotesToggle,
                                                       Converter={StaticResource BoolToVis}}" />

                                <ToggleButton x:Name="TasksToggle" Content="FOLLOW-UP TASKS"
                                          Style="{StaticResource SectionToggleStyle}" />
                                <ItemsControl x:Name="TaskList"
                                          ItemTemplate="{StaticResource TaskTemplate}"
                                          Visibility="{Binding IsChecked, ElementName=TasksToggle,
                                                       Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <!-- People-pivoted (Speakers) recap: collapsible list of per-speaker cards. -->
                            <StackPanel x:Name="SpeakerPanel" Visibility="Collapsed">
                                <ToggleButton x:Name="SpeakersToggle" Content="SPEAKERS"
                                          Style="{StaticResource SectionToggleStyle}" />
                                <ItemsControl x:Name="SpeakerList"
                                          ItemTemplate="{StaticResource SpeakerTemplate}"
                                          Visibility="{Binding IsChecked, ElementName=SpeakersToggle,
                                                       Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- Vision ("crystal ball") page: a full-window canvas the HAL eye dilates into. Clicking the
             bar's eye scales this large centered eye up over the bar; clicking it again returns.
             Placeholder for now — the live concept image renders here once the render tier is wired. -->
        <Grid x:Name="VisionCanvas" Visibility="Collapsed" Opacity="0">
            <Grid.Background>
                <SolidColorBrush Color="#05070A" Opacity="0.97" />
            </Grid.Background>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Large HAL-eye replica, driven by the same audio envelope as the bar's eye. The
                     rendered vision appears INSIDE the orb (the cornea becomes the crystal ball). -->
                <Grid x:Name="HalEyeBig" Width="300" Height="300"
                      Cursor="Hand" Background="Transparent"
                      RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center"
                      ToolTip="Return to captions">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="VisionEyeScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="VisionEyeTranslate" X="0" Y="0" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Ellipse>
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#EDF1F4" Offset="0" />
                                <GradientStop Color="#9AA1A8" Offset="0.5" />
                                <GradientStop Color="#4E5459" Offset="1" />
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Margin="33" Fill="#0A0A0B" />
                    <Ellipse x:Name="HalCorneaBig" Margin="65" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FFD2C2" Offset="0" />
                                <GradientStop Color="#FF1E10" Offset="0.42" />
                                <GradientStop Color="#4A0000" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect x:Name="HalGlowBig" Color="#FF1A14"
                                              ShadowDepth="0" BlurRadius="40" Opacity="0" />
                        </Ellipse.Effect>
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="HalScaleBig" ScaleX="1" ScaleY="1" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <!-- The vision itself, peered into the orb: circular by the ellipse fill, over the
                         red cornea and under the glass gloss. Hidden until a render arrives. -->
                    <Ellipse x:Name="VisionOrb" Margin="65" Visibility="Collapsed" Opacity="0">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="VisionOrbBrush" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <!-- Glass dome reflection: a small top-only highlight (mirrors the bar eye). -->
                    <Ellipse Margin="82,49,134,164" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#59FFFFFF" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="0.7" />
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>

                <TextBlock Text="VISION" HorizontalAlignment="Center" Margin="0,30,0,0"
                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
                           FontWeight="SemiBold" Foreground="#9AA0A6" />

                <!-- The conversation's master feeling (VisualConcept.Theme) — the caption is about the
                     talk, not the picture. -->
                <TextBlock x:Name="VisionStatusText"
                           Text="A live visual concept of the conversation will render here."
                           HorizontalAlignment="Center" Margin="0,10,0,0"
                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="15"
                           Foreground="#C8CCD0" TextWrapping="Wrap" MaxWidth="560"
                           TextAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Click the eye to return" VerticalAlignment="Bottom"
                       HorizontalAlignment="Center" Margin="0,0,0,32"
                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11"
                       Foreground="#3A3F45" />
        </Grid>
    </Grid>
</Window>
