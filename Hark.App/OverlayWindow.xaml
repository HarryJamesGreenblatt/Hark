<Window x:Class="Hark.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HARK Captions"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        SizeToContent="Manual"
        Width="900" Height="220"
        MinWidth="420" MinHeight="120"
        WindowStartupLocation="Manual">

    <!-- Live-Captions-style bar: dark translucent, rounded, soft shadow. Done right: the transcript
         is selectable/copyable and the window is resizable + scrollable, unlike native Live Captions. -->
    <Border x:Name="Bar"
            CornerRadius="12"
            Margin="16"
            Padding="20,14">
        <Border.Background>
            <SolidColorBrush Color="#000000" Opacity="0.82" />
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Border.Resources>
            <!-- Pill button used for the per-speaker shortcuts in the CONVERSATION index. -->
            <Style x:Key="SpeakerButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#E6E8EA" />
                <Setter Property="Background" Value="#2A2D31" />
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}"
                                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#3B7DDD" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.Resources>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Slim header acts as the drag handle and shows live status; hosts the close button. -->
            <Grid Grid.Row="0" x:Name="DragHandle" Background="Transparent" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" x:Name="StatusDot"
                         Width="9" Height="9" VerticalAlignment="Center"
                         Fill="#46D17A" />
                <TextBlock Grid.Column="1" Margin="8,0,0,0"
                           Text="HARK · CONVERSATION"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#9AA0A6" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" x:Name="HintText"
                           Text="Ctrl+Win+H to toggle"
                           HorizontalAlignment="Right"
                           Margin="12,0,0,0"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="11"
                           Foreground="#5F6368" VerticalAlignment="Center" />

                <!-- Close button (✕): exits HARK. Red hover mirrors native window chrome. -->
                <Button Grid.Column="3" x:Name="CloseButton"
                        Width="22" Height="22" Margin="10,0,0,0" Padding="0"
                        Content="✕" FontSize="11"
                        Foreground="#C8CCD0" Background="Transparent"
                        BorderThickness="0" Cursor="Hand"
                        ToolTip="Close HARK">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#E03A3A" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Speaker index: one pill per detected speaker; opens that speaker's page. -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6"
                        x:Name="SpeakerBarPanel" Visibility="Collapsed">
                <TextBlock Text="Speakers:" VerticalAlignment="Center" Margin="0,0,8,0"
                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="11"
                           Foreground="#5F6368" />
                <ItemsControl x:Name="SpeakerBar">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <!-- Rolling transcript: read-only but selectable + copyable, and scrollable when expanded. -->
            <RichTextBox Grid.Row="2" x:Name="CaptionBox"
                         IsReadOnly="True"
                         IsDocumentEnabled="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         Foreground="#FFFFFF"
                         FontFamily="Segoe UI Variable, Segoe UI"
                         FontSize="26"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                <RichTextBox.Resources>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="LineHeight" Value="34" />
                    </Style>
                </RichTextBox.Resources>
                <RichTextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="CopyItem" Header="Copy" InputGestureText="Ctrl+C" />
                        <MenuItem x:Name="CopyAllItem" Header="Copy all" />
                    </ContextMenu>
                </RichTextBox.ContextMenu>
                <FlowDocument x:Name="CaptionDoc" PagePadding="0" />
            </RichTextBox>
        </Grid>
    </Border>
</Window>
