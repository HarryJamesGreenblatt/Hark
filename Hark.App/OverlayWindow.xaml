<Window x:Class="Hark.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HARK Captions"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        SizeToContent="Manual"
        Width="900" Height="220"
        MinWidth="420" MinHeight="120"
        WindowStartupLocation="Manual">

    <!-- Live-Captions-style bar: dark translucent, rounded, soft shadow. Done right: the transcript
         is selectable/copyable and the window is resizable + scrollable, unlike native Live Captions. -->
    <Border x:Name="Bar"
            CornerRadius="12"
            Margin="16"
            Padding="20,14">
        <Border.Background>
            <SolidColorBrush Color="#000000" Opacity="0.82" />
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Slim header acts as the drag handle and shows live status. -->
            <Grid Grid.Row="0" x:Name="DragHandle" Background="Transparent" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" x:Name="StatusDot"
                         Width="9" Height="9" VerticalAlignment="Center"
                         Fill="#46D17A" />
                <TextBlock Grid.Column="1" Margin="8,0,0,0"
                           Text="HARK"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#9AA0A6" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" x:Name="HintText"
                           Text="Ctrl+Win+H to toggle"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="11"
                           Foreground="#5F6368" VerticalAlignment="Center" />
            </Grid>

            <!-- Rolling transcript: read-only but selectable + copyable, and scrollable when expanded. -->
            <RichTextBox Grid.Row="1" x:Name="CaptionBox"
                         IsReadOnly="True"
                         IsDocumentEnabled="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         Foreground="#FFFFFF"
                         FontFamily="Segoe UI Variable, Segoe UI"
                         FontSize="26"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                <RichTextBox.Resources>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="LineHeight" Value="34" />
                    </Style>
                </RichTextBox.Resources>
                <RichTextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="CopyItem" Header="Copy" InputGestureText="Ctrl+C" />
                        <MenuItem x:Name="CopyAllItem" Header="Copy all" />
                    </ContextMenu>
                </RichTextBox.ContextMenu>
                <FlowDocument x:Name="CaptionDoc" PagePadding="0" />
            </RichTextBox>
        </Grid>
    </Border>
</Window>
