<Window x:Class="Hark.App.SpeakerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HARK Speaker"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        SizeToContent="Manual"
        Width="460" Height="320"
        MinWidth="280" MinHeight="140"
        WindowStartupLocation="Manual">

    <!-- A dedicated page for a single speaker's lines, styled like the CONVERSATION overlay. -->
    <Border CornerRadius="12" Margin="16" Padding="20,14">
        <Border.Background>
            <SolidColorBrush Color="#000000" Opacity="0.82" />
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: drag handle + speaker name + close (closes just this page). -->
            <Grid Grid.Row="0" x:Name="DragHandle" Background="Transparent" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="SpeakerLabel"
                           Text="Speaker"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="#9AA0A6" VerticalAlignment="Center" />

                <Button Grid.Column="1" x:Name="CloseButton"
                        Width="22" Height="22" Margin="10,0,0,0" Padding="0"
                        Content="✕" FontSize="11"
                        Foreground="#C8CCD0" Background="Transparent"
                        BorderThickness="0" Cursor="Hand"
                        ToolTip="Close this page">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#E03A3A" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- This speaker's transcript: read-only but selectable + copyable, scrollable. -->
            <RichTextBox Grid.Row="1" x:Name="CaptionBox"
                         IsReadOnly="True"
                         IsDocumentEnabled="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         Foreground="#FFFFFF"
                         FontFamily="Segoe UI Variable, Segoe UI"
                         FontSize="20"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                <RichTextBox.Resources>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="LineHeight" Value="28" />
                    </Style>
                </RichTextBox.Resources>
                <RichTextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="CopyItem" Header="Copy" InputGestureText="Ctrl+C" />
                        <MenuItem x:Name="CopyAllItem" Header="Copy all" />
                    </ContextMenu>
                </RichTextBox.ContextMenu>
                <FlowDocument x:Name="CaptionDoc" PagePadding="0" />
            </RichTextBox>
        </Grid>
    </Border>
</Window>
