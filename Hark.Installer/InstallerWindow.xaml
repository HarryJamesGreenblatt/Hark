<Window x:Class="Hark.Installer.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HARK Setup"
        Width="600" Height="580"
        MinWidth="480" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#0C0C0C"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="HalButton" TargetType="Button">
            <Setter Property="Background" Value="#960A04"/>
            <Setter Property="Foreground" Value="#F0F4F8"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#FF281A" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B4120A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#3A0A08"/>
                                <Setter Property="Foreground" Value="#8A8F96"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Foreground" Value="#F0F4F8"/>
            <Setter Property="CaretBrush" Value="#F0F4F8"/>
            <Setter Property="BorderBrush" Value="#3A3A40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,2,0,10"/>
        </Style>

        <Style x:Key="SubtleButton" TargetType="Button">
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Foreground" Value="#F0F4F8"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#3A3A40" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8A8F96"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar: logo + wordmark -->
        <Border Grid.Row="0" Background="#141416" Padding="24,16">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="LogoImage" Width="56" Height="56" VerticalAlignment="Center" Stretch="Uniform"/>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="HARK" Foreground="#F0F4F8" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Hear. Adapt. Render. Keep.  -  Setup"
                               Foreground="#C8CDD4" FontSize="13" Margin="2,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Body: status, progress, and the (initially hidden) config panel — scrolls when the fields
             exceed the window height so the button bar below never covers them. -->
        <ScrollViewer Grid.Row="1" Padding="24,20,24,12"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="StatusText" Foreground="#C8CDD4" FontSize="13" TextWrapping="Wrap" MinHeight="40"
                           Text="Click Install to set up HARK. It lives in the system tray; press Ctrl+Win+H to caption."/>
                <ProgressBar x:Name="Progress" Height="18" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="0"
                             Background="#1E1E22" Foreground="#960A04" BorderBrush="#FF281A" BorderThickness="1"/>

                <!-- Config fields (the landing): entered/confirmed before Install. Provisioning below is
                     an OPTIONAL post-install step that fills these in. -->
                <StackPanel x:Name="ConfigPanel" Margin="0,18,0,0"/>

                <!-- Provisioning card (revealed AFTER install; optional/skippable): runs the same
                     subscription deployment as the pipeline against the embedded template. -->
                <Border x:Name="ProvisionPanel" Visibility="Collapsed" Margin="0,18,0,0"
                        Background="#141416" BorderBrush="#2A2A2E" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Provision Azure infrastructure" Foreground="#F0F4F8"
                                   FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="Optional. Requires the Azure CLI, signed in (az login) to the target subscription. Runs the deployment and updates the saved settings above."
                                   Foreground="#8A8F96" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Region" Foreground="#C8CDD4" FontSize="12"/>
                                <TextBox x:Name="ProvRegion" Style="{StaticResource FieldBox}" Text="eastus2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Resource group" Foreground="#C8CDD4" FontSize="12"/>
                                <TextBox x:Name="ProvResourceGroup" Style="{StaticResource FieldBox}" Text="rg-hark"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Foundry account name (blank = auto-generate)" Foreground="#C8CDD4" FontSize="12"/>
                        <TextBox x:Name="ProvAccountName" Style="{StaticResource FieldBox}"/>

                        <TextBlock Text="FLUX capacity — requests/min (blank = auto-fit to your quota)" Foreground="#C8CDD4" FontSize="12"/>
                        <TextBox x:Name="ProvFluxCapacity" Style="{StaticResource FieldBox}"/>

                        <CheckBox x:Name="ProvDeployOpenAi" IsChecked="True" Foreground="#C8CDD4" Margin="0,2,0,6"
                                  Content="Deploy Summary + Vision (Azure OpenAI Foundry + FLUX)"/>
                        <CheckBox x:Name="ProvDeployImage" IsChecked="False" Foreground="#C8CDD4" Margin="0,0,0,12"
                                  Content="Also deploy the gpt-image-2 tier"/>

                        <Button x:Name="ProvisionBtn" Style="{StaticResource HalButton}" Content="Provision Azure infra"
                                Height="34" Padding="18,0" HorizontalAlignment="Left" Click="OnProvisionClick"/>
                        <TextBlock x:Name="ProvStatus" Foreground="#C8CDD4" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom bar: the primary action (Install, then Finish once installed). -->
        <Border Grid.Row="2" Background="#141416" BorderBrush="#FF281A" BorderThickness="0,2,0,0" Height="70">
            <Button x:Name="ActionBtn" Style="{StaticResource HalButton}" Content="Install"
                    Width="200" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Click="OnActionClick"/>
        </Border>
    </Grid>
</Window>
